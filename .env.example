# Copy to .env and fill in your key:  cp .env.example .env
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides. These ARE read (agent.py loads .env at import and validates
# each value against the allowed list, warning and falling back on a typo).
# The values shown are the actual defaults.
#
# AGENT_MODEL=claude-haiku-4-5     # claude-haiku-4-5 | claude-sonnet-5 | claude-opus-5
# JUDGE_MODEL=claude-sonnet-5      # claude-sonnet-5 | claude-opus-5
# AGENT_EFFORT=high                # low | medium | high | xhigh | max
#                                  # (ignored on claude-haiku-4-5, which rejects it)
